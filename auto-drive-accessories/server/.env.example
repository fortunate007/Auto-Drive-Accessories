# Local SQLite database file
DATABASE_URL="file:./dev.db"

# Flutterwave dashboard -> Settings -> API Keys (use TEST keys first)
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Flutterwave dashboard -> Settings -> Webhooks -> "Secret hash" (any string you choose, must match)
FLW_WEBHOOK_HASH=change-this-to-a-random-secret-string

# Where the frontend runs, used for CORS and post-payment redirects
CLIENT_URL=http://localhost:5173

PORT=4000
